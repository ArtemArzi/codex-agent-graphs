{
  "schema_version": 2,
  "graph_id": "task-delivery",
  "graph_version": "3.3.0",
  "default_mode": "full",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "max_agents_per_run": 5,
    "max_parallel_agents": 2,
    "max_parallel_explorers": 2,
    "max_parallel_workers": 2,
    "max_slices_per_run": 2,
    "max_selected_skills_per_slice": 3
  },
  "profiles": {
    "light": {"plan_reviewers": 0, "result_reviewers": 0},
    "standard": {"plan_reviewers": 0, "result_reviewers": 1},
    "complex": {"plan_reviewers": 1, "result_reviewers": 1},
    "critical": {"plan_reviewers": 1, "result_reviewers": 2}
  },
  "optional_agents": [
    "task_explorer",
    "task_worker",
    "task_plan_reviewer",
    "task_result_reviewer",
    "task_risk_reviewer"
  ],
  "mcp_policy": {
    "discovery": "required",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "delegation_policy": {
    "default_strategy": "adaptive",
    "profile_preference": {
      "light": "root-only",
      "standard": "delegated-sequential",
      "complex": "delegated-sequential",
      "critical": "delegated-sequential"
    },
    "explicit_slice_request": "required",
    "strategies": [
      "root-only",
      "delegated-sequential",
      "delegated-parallel"
    ],
    "worker_statuses": [
      "done",
      "done_with_concerns",
      "needs_context",
      "blocked"
    ],
    "parallel_write_isolation": "worktree-required",
    "parallel_write_enabled": false
  },
  "routes": {
    "plan": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_plan_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "PLAN.md"}
      }
    },
    "implement": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_result_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "HANDOFF.md"}
      }
    },
    "full": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_result_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "HANDOFF.md"}
      }
    }
  }
}
