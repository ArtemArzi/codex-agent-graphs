{
  "schema_version": 2,
  "graph_id": "task-delivery",
  "graph_version": "3.5.0",
  "default_mode": "full",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "max_agents_per_run": 8,
    "max_parallel_agents": 2,
    "max_parallel_explorers": 2,
    "max_parallel_workers": 2,
    "max_slices_per_run": 2,
    "max_explicit_slices_per_run": 6,
    "max_verification_repair_slices": 1,
    "max_selected_skills_per_slice": 3,
    "max_root_technical_amendments": 2,
    "max_paths_per_scope_amendment": 2
  },
  "profiles": {
    "light": {"plan_reviewers": 0, "result_reviewers": 0},
    "standard": {"plan_reviewers": 0, "result_reviewers": 0},
    "complex": {"plan_reviewers": 1, "result_reviewers": 0},
    "critical": {"plan_reviewers": 1, "result_reviewers": 1}
  },
  "work_policy": {
    "schema_version": 1,
    "fast_path": "root-only",
    "capability_discovery": "need-based",
    "agent_admission": "independent-work-only",
    "review_admission": "risk-or-uncertainty-only",
    "progress_updates": "state-change-only",
    "documentation_followup": "impact-gated",
    "explicit_user_override": "bounded",
    "budgets": {
      "max_agent_starts": 8,
      "max_review_starts": 3,
      "max_repair_cycles": 1,
      "max_no_new_evidence_iterations": 2,
      "max_artifacts_per_work_unit": 3
    },
    "loop_guards": {
      "duplicate_agent_scope": "forbidden",
      "same_scope_retry": "new-evidence-required",
      "repair_start": "first-false-assumption-required",
      "no_new_evidence": "stop-at-budget"
    }
  },
  "execution_policy": {
    "schema_version": 1,
    "default_tier": "skill-only",
    "tiers": {
      "skill-only": {"controller": false, "verification": "self"},
      "tracked": {"controller": true, "verification": "conditional"},
      "verified": {"controller": true, "verification": "required"}
    },
    "admission": {
      "controller": "resumability-or-durable-evidence",
      "verification": "risk-or-uncertainty"
    }
  },
  "optional_agents": [
    "task_explorer",
    "task_worker",
    "task_plan_reviewer",
    "task_result_reviewer",
    "task_risk_reviewer"
  ],
  "mcp_policy": {
    "discovery": "when-relevant",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "not_applicable_prefix": "mcp:not-applicable:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "delegation_policy": {
    "default_strategy": "adaptive",
    "profile_preference": {
      "light": "root-only",
      "standard": "root-only",
      "complex": "root-only",
      "critical": "root-only"
    },
    "explicit_slice_request": "required",
    "strategies": [
      "root-only",
      "delegated-sequential",
      "delegated-parallel"
    ],
    "worker_statuses": [
      "done",
      "done_with_concerns",
      "needs_context",
      "blocked"
    ],
    "parallel_write_isolation": "worktree-required",
    "parallel_write_enabled": false
  },
  "context_policy": {
    "checkpoint_schema_version": 1,
    "checkpoint_after": "slice-accept",
    "rehydrate_before": "next-slice",
    "host_compact": "optional",
    "global_hook_required": false
  },
  "test_policy": {
    "packet_schema_version": 2,
    "check_identity": "sha256-command-purpose",
    "impact_actions": ["reuse", "update", "add", "not-applicable"],
    "impact_levels": ["unit", "integration", "e2e", "static", "other"],
    "required_impact_levels": ["unit", "integration", "e2e"],
    "root_replay_minimum_per_slice": 1,
    "deferred_final_checks": "exact-union-by-check-id"
  },
  "scope_amendment_policy": {
    "allowed_authority": "root-technical",
    "review_effect": "preserve-reviewed-base-through-digest-chain",
    "protected_prefixes": [
      ".git",
      ".codex",
      ".agent-graphs",
      ".github/workflows",
      ".circleci",
      ".buildkite",
      ".teamcity",
      "db/migrate",
      "alembic/versions",
      "migrations",
      "secrets"
    ],
    "protected_names": [
      ".env",
      ".env.local",
      ".env.production",
      "schema.prisma",
      "schema.rb",
      "schema.sql",
      "structure.sql",
      ".gitlab-ci.yml",
      ".travis.yml",
      ".drone.yml",
      ".cirrus.yml",
      "bitrise.yml",
      "buildspec.yml",
      "buildspec.yaml",
      "jenkinsfile",
      "azure-pipelines.yml",
      "bitbucket-pipelines.yml",
      "cloudbuild.yaml",
      "appveyor.yml"
    ]
  },
  "routes": {
    "plan": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_plan_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "PLAN.md"}
      }
    },
    "implement": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_result_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "HANDOFF.md"}
      }
    },
    "full": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "task.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "task_result_reviewer",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": "HANDOFF.md"}
      }
    }
  }
}
