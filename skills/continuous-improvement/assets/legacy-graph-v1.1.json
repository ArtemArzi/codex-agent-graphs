{
  "schema_version": 2,
  "graph_id": "continuous-improvement",
  "graph_version": "1.1.0",
  "default_mode": "full",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "max_candidates_per_run": 1,
    "max_changed_files": 8,
    "max_parallel_explorers": 1
  },
  "work_policy": {
    "schema_version": 1,
    "fast_path": "root-only",
    "capability_discovery": "need-based",
    "agent_admission": "independent-work-only",
    "review_admission": "risk-or-uncertainty-only",
    "progress_updates": "state-change-only",
    "documentation_followup": "impact-gated",
    "explicit_user_override": "bounded",
    "budgets": {
      "max_agent_starts": 2,
      "max_review_starts": 1,
      "max_repair_cycles": 1,
      "max_no_new_evidence_iterations": 2,
      "max_artifacts_per_work_unit": 3
    },
    "loop_guards": {
      "duplicate_agent_scope": "forbidden",
      "same_scope_retry": "new-evidence-required",
      "repair_start": "first-false-assumption-required",
      "no_new_evidence": "stop-at-budget"
    }
  },
  "execution_policy": {
    "schema_version": 1,
    "default_tier": "tracked",
    "tiers": {
      "tracked": {"controller": true, "verification": "conditional"},
      "verified": {"controller": true, "verification": "required"}
    },
    "admission": {
      "controller": "resumability-or-durable-evidence",
      "verification": "risk-or-uncertainty"
    }
  },
  "optional_agents": ["explorer", "improvement_verifier"],
  "mcp_policy": {
    "discovery": "when-relevant",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "not_applicable_prefix": "mcp:not-applicable:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "candidate_policy": {
    "delivery_source_kinds": [
      "failing-ci",
      "failing-test",
      "issue-reproduction",
      "recent-regression",
      "static-analysis",
      "documentation-defect"
    ],
    "protected_path_fragments": [
      "auth",
      "permission",
      "security",
      "secret",
      "billing",
      "payment",
      "migration",
      "deploy",
      "infrastructure"
    ],
    "protected_domains": [
      "authentication",
      "authorization",
      "security",
      "secrets",
      "billing",
      "payments",
      "data-migration",
      "deployment",
      "infrastructure",
      "public-contract",
      "business-semantics"
    ]
  },
  "delivery_policy": {
    "required_skill": "task-delivery",
    "minimum_profile": "standard",
    "default_branches": ["main", "master", "trunk"],
    "branch_prefix": "codex/continuous-improvement-",
    "allow_push": false,
    "allow_merge": false,
    "allow_deploy": false
  },
  "routes": {
    "full": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "improvement.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "improvement_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {
          "role": "root",
          "artifact": "IMPROVEMENT.md"
        }
      }
    },
    "audit": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "improvement.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "improvement_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {
          "role": "root",
          "artifact": "IMPROVEMENT.md"
        }
      }
    }
  }
}
