{
  "schema_version": 2,
  "graph_id": "continuous-improvement",
  "graph_version": "1.0.0",
  "default_mode": "full",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "max_candidates_per_run": 1,
    "max_changed_files": 8,
    "max_parallel_explorers": 1
  },
  "optional_agents": ["explorer", "improvement_verifier"],
  "mcp_policy": {
    "discovery": "required",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "candidate_policy": {
    "delivery_source_kinds": [
      "failing-ci",
      "failing-test",
      "issue-reproduction",
      "recent-regression",
      "static-analysis",
      "documentation-defect"
    ],
    "protected_path_fragments": [
      "auth",
      "permission",
      "security",
      "secret",
      "billing",
      "payment",
      "migration",
      "deploy",
      "infrastructure"
    ],
    "protected_domains": [
      "authentication",
      "authorization",
      "security",
      "secrets",
      "billing",
      "payments",
      "data-migration",
      "deployment",
      "infrastructure",
      "public-contract",
      "business-semantics"
    ]
  },
  "delivery_policy": {
    "required_skill": "task-delivery",
    "minimum_profile": "standard",
    "default_branches": ["main", "master", "trunk"],
    "branch_prefix": "codex/continuous-improvement-",
    "allow_push": false,
    "allow_merge": false,
    "allow_deploy": false
  },
  "routes": {
    "full": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "improvement.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "improvement_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {
          "role": "root",
          "artifact": "IMPROVEMENT.md"
        }
      }
    },
    "audit": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "improvement.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "improvement_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {
          "role": "root",
          "artifact": "IMPROVEMENT.md"
        }
      }
    }
  }
}
