{
  "schema_version": 2,
  "graph_id": "research",
  "graph_version": "2.3.0",
  "entry": "work",
  "terminal": "complete",
  "default_depth": "auto",
  "limits": {
    "max_node_retries": 2,
    "max_verification_repairs": 1,
    "fast": {
      "soft_time_minutes": 10,
      "source_checkpoints": [4, 6, 10],
      "max_sources": 10,
      "max_parallel_scouts": 0
    },
    "deep": {
      "soft_time_minutes": 30,
      "source_checkpoints": [10, 20, 40],
      "max_sources": 40,
      "max_parallel_scouts": 3
    }
  },
  "work_policy": {
    "schema_version": 1,
    "fast_path": "root-only",
    "capability_discovery": "need-based",
    "agent_admission": "independent-work-only",
    "review_admission": "risk-or-uncertainty-only",
    "progress_updates": "state-change-only",
    "documentation_followup": "impact-gated",
    "explicit_user_override": "bounded",
    "budgets": {
      "max_agent_starts": 4,
      "max_review_starts": 1,
      "max_repair_cycles": 1,
      "max_no_new_evidence_iterations": 2,
      "max_artifacts_per_work_unit": 3
    },
    "loop_guards": {
      "duplicate_agent_scope": "forbidden",
      "same_scope_retry": "new-evidence-required",
      "repair_start": "first-false-assumption-required",
      "no_new_evidence": "stop-at-budget"
    }
  },
  "execution_policy": {
    "schema_version": 1,
    "default_tier": "skill-only",
    "tiers": {
      "skill-only": {"controller": false, "verification": "self"},
      "tracked": {"controller": true, "verification": "conditional"},
      "verified": {"controller": true, "verification": "required"}
    },
    "admission": {
      "controller": "resumability-or-durable-evidence",
      "verification": "risk-or-uncertainty"
    }
  },
  "optional_agents": [
    "research_planner",
    "research_scout",
    "research_synthesizer"
  ],
  "mcp_policy": {
    "discovery": "when-relevant",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "not_applicable_prefix": "mcp:not-applicable:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "nodes": {
    "work": {
      "role": "root",
      "artifact": "research.json",
      "on_success": "complete",
      "on_verify": "verify"
    },
    "verify": {
      "role": "research_verifier",
      "artifact": "verification.json",
      "on_success": "complete",
      "on_rejected": "work"
    },
    "complete": {
      "role": "root",
      "artifact": "report.md"
    }
  }
}
