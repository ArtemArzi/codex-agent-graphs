{
  "schema_version": 2,
  "graph_id": "research",
  "graph_version": "2.1.0",
  "entry": "work",
  "terminal": "complete",
  "default_depth": "auto",
  "limits": {
    "max_node_retries": 2,
    "max_verification_repairs": 1,
    "fast": {
      "soft_time_minutes": 10,
      "source_checkpoints": [4, 6, 10],
      "max_sources": 10,
      "max_parallel_scouts": 0
    },
    "deep": {
      "soft_time_minutes": 30,
      "source_checkpoints": [10, 20, 40],
      "max_sources": 40,
      "max_parallel_scouts": 3
    }
  },
  "optional_agents": [
    "research_planner",
    "research_scout",
    "research_synthesizer"
  ],
  "nodes": {
    "work": {
      "role": "root",
      "artifact": "research.json",
      "on_success": "complete",
      "on_verify": "verify"
    },
    "verify": {
      "role": "research_verifier",
      "artifact": "verification.json",
      "on_success": "complete",
      "on_rejected": "work"
    },
    "complete": {
      "role": "root",
      "artifact": "report.md"
    }
  }
}
