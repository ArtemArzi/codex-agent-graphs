{
  "schema_version": 2,
  "graph_id": "project-start",
  "graph_version": "3.4.0",
  "default_mode": "auto",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "bootstrap": {
      "soft_time_minutes": 30,
      "max_parallel_explorers": 2
    },
    "maintenance": {
      "soft_time_minutes": 5,
      "max_parallel_explorers": 2
    }
  },
  "capability_registry": {
    "skills": [
      "grilling",
      "domain-modeling",
      "grill-with-docs",
      "codebase-design",
      "to-spec",
      "to-tickets",
      "wayfinder",
      "research",
      "prototype",
      "task-delivery"
    ],
    "optional_skills": ["setup-matt-pocock-skills"],
    "default_backend": "native-codex",
    "optional_backends": ["sandcastle"]
  },
  "mcp_policy": {
    "discovery": "required",
    "relevant_use": "required",
    "receipt_prefix": "mcp:",
    "fallback_prefix": "mcp:fallback:",
    "selection_order": [
      "provider-specific-mcp",
      "context7-for-library-docs",
      "research-or-service-mcp",
      "native-web-or-browser",
      "curl"
    ]
  },
  "documentation_contract": {
    "coverage": [
      "business",
      "documentation_map",
      "domain_context",
      "foundation",
      "codebase",
      "quality",
      "plan",
      "agent_context",
      "skill_contract"
    ],
    "anchors": {
      "agent_context": "AGENTS.md",
      "documentation_map": "docs/README.md",
      "domain_context": ["CONTEXT.md", "CONTEXT-MAP.md"],
      "skill_contract": ["docs/agents/domain.md", "docs/agents/issue-tracker.md"]
    },
    "required_bootstrap_skills": ["domain-modeling", "codebase-design"],
    "skill_contract_providers": [
      "setup-matt-pocock-skills",
      "project-start:skill-contract-fallback"
    ]
  },
  "optional_agents": ["explorer"],
  "legacy_v2_bootstrap": {
    "phases": ["discovery", "foundation", "planning", "tickets", "execution", "complete"],
    "events": {
      "foundation": [
        "foundation-research",
        "foundation-stack",
        "foundation-codebase",
        "foundation-quality",
        "foundation-ready"
      ],
      "tickets": ["tickets-approved", "tickets-published"],
      "completion": ["implementation-evidence", "user-acceptance"]
    }
  },
  "routes": {
    "bootstrap": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "project.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "project_docs_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": ".project-start/state.json"}
      }
    },
    "maintenance": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "project.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "project_docs_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": ".project-start/state.json"}
      }
    }
  }
}
