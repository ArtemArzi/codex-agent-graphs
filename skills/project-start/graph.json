{
  "schema_version": 2,
  "graph_id": "project-start",
  "graph_version": "3.1.0",
  "default_mode": "auto",
  "limits": {
    "max_node_retries": 1,
    "max_verification_repairs": 1,
    "bootstrap": {
      "soft_time_minutes": 30,
      "max_parallel_explorers": 2
    },
    "maintenance": {
      "soft_time_minutes": 5,
      "max_parallel_explorers": 2
    }
  },
  "capability_registry": {
    "skills": [
      "grilling",
      "domain-modeling",
      "grill-with-docs",
      "codebase-design",
      "setup-matt-pocock-skills",
      "to-spec",
      "to-tickets",
      "wayfinder",
      "research",
      "prototype",
      "task-delivery"
    ],
    "default_backend": "native-codex",
    "optional_backends": ["sandcastle"]
  },
  "optional_agents": ["explorer"],
  "legacy_v2_bootstrap": {
    "phases": ["discovery", "foundation", "planning", "tickets", "execution", "complete"],
    "events": {
      "foundation": [
        "foundation-research",
        "foundation-stack",
        "foundation-codebase",
        "foundation-quality",
        "foundation-ready"
      ],
      "tickets": ["tickets-approved", "tickets-published"],
      "completion": ["implementation-evidence", "user-acceptance"]
    }
  },
  "routes": {
    "bootstrap": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "project.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "project_docs_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": ".project-start/state.json"}
      }
    },
    "maintenance": {
      "entry": "work",
      "terminal": "complete",
      "nodes": {
        "work": {
          "role": "root",
          "artifact": "project.json",
          "on_success": "complete",
          "on_verify": "verify",
          "on_decision": "decision-required"
        },
        "verify": {
          "role": "project_docs_verifier",
          "artifact": "verification.json",
          "on_success": "complete",
          "on_rejected": "work"
        },
        "complete": {"role": "root", "artifact": ".project-start/state.json"}
      }
    }
  }
}
